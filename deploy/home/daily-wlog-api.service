# /etc/systemd/system/daily-wlog-api.service
[Unit]
Description=daily-wlog API
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/daily-wlog/api
EnvironmentFile=/etc/daily-wlog/api.env
Restart=always
RestartSec=3
User=daily-wlog
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
