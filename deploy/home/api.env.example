# /etc/daily-wlog/api.env — fill in and chmod 600.
#
# DATABASE_URL uses the session pooler (port 5432), not the direct
# db.<ref>.supabase.co host: direct connections are IPv6-only, which home
# networks often lack, and our pgx pool needs session mode (transaction
# mode breaks prepared statements). Copy the exact string from the
# dashboard: Connect -> Session pooler.
DATABASE_URL=postgresql://postgres.tebfjmsmnhfeapbzytxy:DB_PASSWORD_HERE@aws-1-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_JWKS_URL=https://tebfjmsmnhfeapbzytxy.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_URL=https://tebfjmsmnhfeapbzytxy.supabase.co/storage/v1
# Settings -> API keys -> create a secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
PORT=8080
